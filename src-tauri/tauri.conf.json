{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox AFK",
  "version": "1.0.0",
  "identifier": "com.neil.robloxafk",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Roblox AFK", "width": 480, "height": 780, "resizable": false, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
